# BKS West Bengal website — local environment

Copy to `.env.local` and fill values. Never commit secrets.

# --- Supabase (BKS project lhnorkjfldywnrqqunqn ONLY) ---
# Do not point this app at KarmYog Vatika or any other Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://lhnorkjfldywnrqqunqn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for /admin/district-members mutations and photo upload.
# Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin gate (shared key pattern used by sibling BKS apps) ---
# Long random string. Entered on /admin/district-members; sent as x-admin-key.
# Never hard-code. Never log. Never put in NEXT_PUBLIC_*.
BKS_ADMIN_KEY=

# --- Optional existing features ---
GEMINI_API_KEY=
